---
import { beats } from '../data/beats';
// Placeholder ratios until the real photographs land — alternated so both cases are visible.
// A real <img> will size to its own ratio inside the same envelope.
const ratios = ['4 / 3', '3 / 4', '4 / 3', '3 / 4'];
---
<section id="journey" class="section" aria-labelledby="journey-h">
  <div class="shell">
    <h2 id="journey-h" class="col-title text-h2 mb-8 lg:mb-12 reveal">How I got here</h2>
  </div>

  <div class="j-list">
    {beats.map((b, i) => (
      <article class="beat shell" data-beat>
        <div class="beat-text reveal">
          <p class="text-meta text-tertiary mb-2">{b.place} · {b.when}</p>
          <h3 class="text-h2 mb-3" set:html={b.heading} />
          <p class="text-secondary" set:html={b.body} />
        </div>
        <div class={`beat-photo${b.photos ? ' has-pin' : ''}`} aria-hidden="true" style={`--ar:${ratios[i % ratios.length]}`} data-drift data-rate="-0.03">
          {b.photos ? (
            <div class="pin">
              {b.photos.map((ph) => <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" />)}
            </div>
          ) : (
            <div class="ph"><span>Photo · {b.photo}</span></div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Each beat is its own .shell, so the copy and its photograph are placed by column rather
     than by arithmetic. Copy in 4-8. The photograph starts two columns before the copy's right
     edge — column 7 — and runs five columns to 11, sitting BEHIND the copy on the same row.
     Its left 45% dissolves, which is exactly the two columns the words sit on, so the words
     always read and the photograph stays rich on the side they never touch. */
  .j-list{display:grid;row-gap:96px}
  .beat{position:relative;row-gap:24px}
  .beat-text{grid-column:1/-1;position:relative;z-index:1}

  .beat-photo{
    grid-column:1/-1;
    order:-1;               /* above the copy on mobile; explicit row placement overrides this on desktop */
    justify-self:end;
    width:55%;
    z-index:0;
    pointer-events:none;
    /* on mobile the drift can carry it into the heading; its lower edge dissolves so that reads
       as the photograph sitting behind the words rather than colliding with them */
    -webkit-mask:linear-gradient(to bottom, #000 55%, transparent);
    mask:linear-gradient(to bottom, #000 55%, transparent);
  }
  /* Envelope: full width of its columns, no taller than 60vh, at the image's own ratio. */
  .beat-photo .ph{
    width:min(100%, calc(60vh * var(--ar, 1)));
    aspect-ratio:var(--ar, 1);
    margin-left:auto;
  }

  /* The pinboard. Four photographs placed by hand and sized by what each one is: the people
     large, the card card-sized, the two app screens in between. No overlap, no motion of their
     own — the reveal is the motion. The Walmart screen is a tall leaderboard and is cropped to
     a short frame; these are a glimpse of the time, not the work. Positions are percentages of
     the slot, so the composition holds at any width. The slot's left 45% dissolves under the
     copy, so the people and the casino screen — the two with the most in them — are kept
     towards the clear side. */
  .pin{position:relative;width:100%;aspect-ratio:1.3}
  .pin img{position:absolute;display:block;object-fit:cover;background:var(--color-surface);
           box-shadow:0 14px 30px -16px rgb(0 0 0 / .7)}
  .pin img:nth-child(1){left:4%;top:0;width:58%;aspect-ratio:3/2;transform:rotate(-1.2deg)}       /* team */
  .pin img:nth-child(2){right:0;top:6%;width:26%;aspect-ratio:3/4;object-position:top;transform:rotate(2deg)}   /* fan-o-matic, cropped */
  .pin img:nth-child(3){left:26%;bottom:4%;width:38%;aspect-ratio:4/3;transform:rotate(-2deg)}    /* spin to win */
  .pin img:nth-child(4){right:3%;bottom:14%;width:24%;aspect-ratio:4/3;transform:rotate(4deg)}    /* card */
  /* on mobile the composition takes the full width; five images at 55% would be stamps */
  .beat-photo.has-pin{width:100%}

  @media (min-width:1024px){
    .j-list{row-gap:128px}
    .beat{min-height:480px;align-items:center}
    .beat-text{grid-column:4/9;grid-row:1}
    .beat-photo{
      grid-column:7/12;grid-row:1;
      justify-self:stretch;width:auto;               /* stretch, so the negative margin can widen it */
      margin-right:calc(-1 * var(--grid-gutter));   /* ends on the column-12 line */
      align-self:center;
      /* the part under the words dissolves */
      -webkit-mask:linear-gradient(to right, transparent 0%, #000 45%);
      mask:linear-gradient(to right, transparent 0%, #000 45%);
      /* Reveal: arrives, not appears. Fades in over 500ms while settling from 1.05 to 1 and
         drifting 16px left to rest. Leaves faster, and without the scale, so moving between
         beats reads as a crossfade rather than two things animating. */
      opacity:0;
      transform:translateX(16px) scale(1.05);
      transform-origin:left center;
      transition:opacity .28s var(--ease-out-soft), transform .28s var(--ease-out-soft);
      translate:none;   /* no drift on desktop; the hover reveal is the motion here */
    }
    .beat:hover .beat-photo,
    .beat.is-hot .beat-photo,
    .beat:focus-within .beat-photo{
      opacity:1;
      transform:none;
      transition:opacity .5s var(--ease-out-soft), transform .7s var(--ease-out-soft);
    }
  }

  @media (prefers-reduced-motion:reduce){
    .beat-photo{transition:none!important}
  }
</style>

<script>
  // Browsers do not recompute :hover while the page scrolls under a stationary pointer — the
  // state only updates on the next mousemove. So a beat arriving under the cursor mid-scroll
  // stayed dark until the mouse twitched. On every scroll frame this hit-tests whatever is
  // under the last known pointer position and drives the reveal from a class instead.
  // The target is the whole beat row, full shell width, not just the copy.
  function journeyHover() {
    if ((window as any).__journeyHover) return;
    (window as any).__journeyHover = true;
    if (!matchMedia('(pointer: fine)').matches) return;

    let mx = -1, my = -1, ticking = false;
    const sync = () => {
      ticking = false;
      const el = mx < 0 ? null : document.elementFromPoint(mx, my);
      const beat = el?.closest?.('.beat') as HTMLElement | null;
      document.querySelectorAll<HTMLElement>('.beat.is-hot').forEach((b) => { if (b !== beat) b.classList.remove('is-hot'); });
      beat?.classList.add('is-hot');
    };
    const ask = () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } };

    addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; ask(); }, { passive: true });
    addEventListener('scroll', ask, { passive: true });
    document.addEventListener('mouseleave', () => { mx = -1; my = -1; ask(); });
  }
  document.addEventListener('astro:page-load', journeyHover);
</script>
