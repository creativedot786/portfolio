---
import { beats } from '../data/beats';
---
<section id="journey" class="section" aria-labelledby="journey-h">
  <div class="shell">
    <h2 id="journey-h" class="col-title text-h2 mb-8 lg:mb-12 reveal">How I got here</h2>
  </div>

  <div class="j-list">
    {beats.map((b) => (
      <article class="beat shell" data-beat>
        <div class="beat-text reveal">
          <h3 class="text-h2 mb-3"><span class="sr-only">{b.place}, {b.when}. </span><span set:html={b.heading} /></h3>
          <p class="text-secondary" set:html={b.body} />
        </div>
        <div class="beat-photo" aria-hidden="true" data-drift data-rate="-0.03">
          <div class="board">
            {b.photos.map((ph) => (
              <figure class="snap" style={`grid-column:${ph.col};grid-row:${ph.row};aspect-ratio:${ph.ar};${ph.align ? `align-self:${ph.align};` : ''}`}>
                <i class={`tape ${ph.tape}`}></i>
                <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Each beat is its own .shell, so the copy and its photograph are placed by column rather
     than by arithmetic. Copy in 4-8. The photograph starts two columns before the copy's right
     edge — column 7 — and runs five columns to 11, sitting BEHIND the copy on the same row.
     Its left 45% dissolves, which is exactly the two columns the words sit on, so the words
     always read and the photograph stays rich on the side they never touch. */
  .j-list{display:grid;row-gap:96px}
  .beat{position:relative;row-gap:24px}
  .beat-text{grid-column:1/-1;position:relative;z-index:1}
  .beat-text h3{text-wrap:balance}

  /* The tape overhangs each photograph, and a mask clips to the element's own box — so the
     slot carries padding for the overhang and gives it back with negative margins. */
  .beat{--tape-room:20px}   /* 20 on mobile: the page margin is 24, so the overhang stays inside the viewport */
  .beat-photo{
    grid-column:1/-1;
    order:-1;               /* above the copy on mobile; explicit row placement overrides this on desktop */
    justify-self:end;
    width:100%;             /* the board takes the full width on mobile; three photographs at 55% would be stamps */
    z-index:0;
    pointer-events:none;
    padding:var(--tape-room) var(--tape-room) 0;
    margin:calc(-1 * var(--tape-room)) calc(-1 * var(--tape-room)) 0;
    /* on mobile the drift can carry it into the heading; its lower edge dissolves so that reads
       as the photograph sitting behind the words rather than colliding with them */
    -webkit-mask:linear-gradient(to bottom, #000 55%, transparent);
    mask:linear-gradient(to bottom, #000 55%, transparent);
  }
  /* The board. A five-column grid inside the slot whose tracks are the page's own columns and
     gutters, so every photograph starts on a line and ends on one — the trailing gutter track
     is what lets a span end on the column-12 line. No rotation: the grid is the pinboard, and
     the tape is what says pinned. Photographs are sized by the columns, not by eye; the one in
     the slot's left two columns is the one that fades under the copy, so it is the one the
     beat can afford to lose. Per-photo placement lives with the photo in beats.ts. */
  .board{display:grid;grid-template-columns:repeat(5, 1fr var(--grid-gutter));column-gap:0;row-gap:var(--grid-gutter);width:100%}
  .snap{margin:0;position:relative;width:100%}
  .snap img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:inherit;background:var(--color-surface);
          box-shadow:0 14px 30px -16px rgb(0 0 0 / .7)}
  /* One strip of tape per photograph: translucent accent, torn ends. Accent is otherwise
     reserved for meaning (the active link, the highlighted word, the glasses); here it is the
     one decorative use on the site, kept to one strip each and to this section. */
  .tape{position:absolute;z-index:1;width:74px;height:20px;pointer-events:none;
        background:color-mix(in srgb, var(--color-accent) 42%, transparent);
        clip-path:polygon(0 18%,2% 0,98% 6%,100% 24%,99% 82%,97% 100%,3% 94%,1% 78%);
        box-shadow:inset 0 0 0 1px color-mix(in srgb, #fff 8%, transparent)}
  .tape.t{left:50%;top:-9px;transform:translateX(-50%) rotate(-2deg)}
  /* corner strips are shorter: on the diagonal the same length reads longer */
  .tape.tl,.tape.tr{width:60px;height:18px}
  .tape.tl{left:-18px;top:8px;transform:rotate(-42deg)}
  .tape.tr{right:-18px;top:8px;transform:rotate(42deg)}
  :root[data-theme="cream"] .tape{box-shadow:inset 0 0 0 1px color-mix(in srgb, #000 6%, transparent)}
  @media (min-width:1024px){
    .j-list{row-gap:128px}
    .beat{min-height:480px;align-items:center;--tape-room:28px}
    .beat-text{grid-column:4/9;grid-row:1}
    .beat-photo{
      grid-column:7/12;grid-row:1;
      justify-self:stretch;width:auto;               /* stretch, so the negative margin can widen it */
      margin-right:calc(-1 * var(--grid-gutter) - var(--tape-room));   /* ends on the column-12 line, plus room for the tape */
      align-self:center;
      /* the part under the words dissolves */
      -webkit-mask:linear-gradient(to right, transparent var(--tape-room), #000 calc(45% + var(--tape-room) * .1));   /* opaque at 45% of the board, not of the padded box */
      mask:linear-gradient(to right, transparent var(--tape-room), #000 calc(45% + var(--tape-room) * .1));
      /* Reveal: arrives, not appears. Fades in over 500ms while settling from 1.05 to 1 and
         drifting 16px left to rest. Leaves faster, and without the scale, so moving between
         beats reads as a crossfade rather than two things animating. */
      opacity:0;
      transform:translateX(16px) scale(1.05);
      transform-origin:left center;
      transition:opacity .28s var(--ease-out-soft), transform .28s var(--ease-out-soft);
      translate:none;   /* no drift on desktop; the hover reveal is the motion here */
    }
    .beat:hover .beat-photo,
    .beat.is-hot .beat-photo,
    .beat:focus-within .beat-photo{
      opacity:1;
      transform:none;
      transition:opacity .5s var(--ease-out-soft), transform .7s var(--ease-out-soft);
    }
  }

  @media (prefers-reduced-motion:reduce){
    .beat-photo{transition:none!important}
  }
</style>

<script>
  // Browsers do not recompute :hover while the page scrolls under a stationary pointer — the
  // state only updates on the next mousemove. So a beat arriving under the cursor mid-scroll
  // stayed dark until the mouse twitched. On every scroll frame this hit-tests whatever is
  // under the last known pointer position and drives the reveal from a class instead.
  // The target is the whole beat row, full shell width, not just the copy.
  function journeyHover() {
    if ((window as any).__journeyHover) return;
    (window as any).__journeyHover = true;
    if (!matchMedia('(pointer: fine)').matches) return;

    let mx = -1, my = -1, ticking = false;
    const sync = () => {
      ticking = false;
      const el = mx < 0 ? null : document.elementFromPoint(mx, my);
      const beat = el?.closest?.('.beat') as HTMLElement | null;
      document.querySelectorAll<HTMLElement>('.beat.is-hot').forEach((b) => { if (b !== beat) b.classList.remove('is-hot'); });
      beat?.classList.add('is-hot');
    };
    const ask = () => { if (!ticking) { ticking = true; requestAnimationFrame(sync); } };

    addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; ask(); }, { passive: true });
    addEventListener('scroll', ask, { passive: true });
    document.addEventListener('mouseleave', () => { mx = -1; my = -1; ask(); });
  }
  document.addEventListener('astro:page-load', journeyHover);
</script>
