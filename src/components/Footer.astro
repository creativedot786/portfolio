---
import { site } from '../data/site';
const year = new Date().getFullYear();
// The strip is the transition between the site's two grounds, so it is mixed from them rather
// than from a neutral grey ramp: band 1 is exactly --color-page (dissolving into the page above)
// and band 9 is exactly --color-primary (the footer's own ground, so there is no seam below).
// The percentages keep the original ramp's rhythm — slow at the ends, quicker through the middle.
const steps = [0, 7, 18, 27, 41, 63, 85, 93, 100];
const bands = steps.map((n) => `color-mix(in srgb, var(--color-primary) ${n}%, var(--color-page))`);
const arrow = 'inline-flex items-center gap-1.5';
---
<footer id="contact" class="bg-inverse text-on-inverse" data-cursor-invert>
  <div class="strip-wrap" data-strip aria-hidden="true">
    <div class="strip">
      {bands.map((c) => <div class="h-7 max-md:h-5" style={`background:${c}`}></div>)}
    </div>
  </div>

  <div class="foot-body pt-5 pb-5">
    <div class="shell gap-y-5"><div class="col-full grid gap-5 lg:grid-cols-[1fr_auto] lg:gap-8">
      <div>
        <p class="text-body md:text-h3 leading-[1.55] tabular-nums">{site.location}</p>
        <p class="text-body md:text-h3 leading-[1.55] tabular-nums" data-clock aria-live="off">—</p>
      </div>
      <div class="lg:justify-self-end font-bold text-body md:text-h3 leading-[1.55]">
        <p><a class={arrow} href={`mailto:${site.email}`}>{site.emailShown}<svg class="arr w-[14px] h-[14px]" viewBox="0 0 14.4 14.4" aria-hidden="true"><path d="M1.2 13.2L13.2 1.2M13.2 1.2H1.2M13.2 1.2V13.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" fill="none"/></svg></a></p>
        <p><a class={arrow} href={site.linkedin} target="_blank" rel="noopener">LinkedIn<svg class="arr w-[14px] h-[14px]" viewBox="0 0 14.4 14.4" aria-hidden="true"><path d="M1.2 13.2L13.2 1.2M13.2 1.2H1.2M13.2 1.2V13.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" fill="none"/></svg></a></p>
        <p><a class={arrow} href={site.resume} target="_blank" rel="noopener">Resume<svg class="arr w-[14px] h-[14px]" viewBox="0 0 14.4 14.4" aria-hidden="true"><path d="M1.2 13.2L13.2 1.2M13.2 1.2H1.2M13.2 1.2V13.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" fill="none"/></svg></a></p>
      </div>
    </div></div>
    <div class="shell"><div class="col-full mt-6 max-md:mt-5 flex items-baseline justify-between gap-6">
      <p class="text-body md:text-h3">©{year}</p>
      <p class="hc-ghint text-meta opacity-60">Press <kbd>G</kbd> to see the grid</p>
    </div></div>
  </div>
</footer>
<style>
  /* The strip is tied to the scroll (src/chrome/chrome.js sets --fp on the footer, 0 to 1): the bands
     grow as the footer comes up the screen and are complete when it reaches the middle, and shrink if
     you scroll back up. It used to play once, 220px before the footer was on screen, so anyone who
     paused just above it scrolled down to a strip that had already finished.
     Origin TOP: growing downward continues the scroll rather than running against it. */
  :global(html.js) .strip{transform:scaleY(var(--fp,1));transform-origin:top;will-change:transform}
  /* the content arrives in the last part of the strip, so the footer reads as one object */
  :global(html.js) .foot-body{opacity:clamp(0,calc((var(--fp,1) - .55) / .45),1);transform:translateY(calc((1 - var(--fp,1)) * 14px))}
  @media (prefers-reduced-motion:reduce){
    :global(html.js) .strip{transform:none}
    :global(html.js) .foot-body{opacity:1;transform:none}
  }
</style>
<script>
  function footer() {
    const els = document.querySelectorAll('[data-clock]');
    const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true, timeZone: 'Asia/Dubai' });
    const tick = () => { const t = fmt.format(new Date()) + ' (Local Time)'; els.forEach((e) => { e.textContent = t; }); };
    tick();
    const w = window as any;
    if (w.__clock) clearInterval(w.__clock);
    w.__clock = setInterval(tick, 1000);

    // the strip itself is driven by the shared chrome (src/chrome/chrome.js), with the case studies' one
  }
  document.addEventListener('astro:page-load', footer);
</script>
