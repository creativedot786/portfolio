---
// The Scout card's picture on the home page: a short loop, like a product intro. On a field of fine dots in
// the theme's ink (the same particle idea as "build with AI" in the hero), it opens on Scout's orb (the
// prototype's own shader), alone. The camera pulls back: it zooms out, tilts back as the phone lands and
// straightens, in one smooth move, with the phone fading in around the orb. Then one real turn from the
// recorded session: the message; Scout thinks; what Scout understood rises out of the phone (the dots behind
// it brighten softly); Scout's reply; what Scout found rises out too. It plays as soon as a good part of the card is in view and starts over once it has left the screen. At rest it shows the intro's first frame, and each loop ends by moving back to it, so it never
// cuts. Reduced motion: the finished turn, still.
---
<div class="sp promo-img" data-scout-promo data-cursor-expand role="img"
  aria-label="Scout, an AI property search on a phone. Someone asks for a 2-bed near their office in DIFC, around 130k a year, with a dog. Beside the phone, Scout's memory shows what it understood: 2-bed, near DIFC (a guess), about 130k a year, pet-friendly. Then the home it found: a 2-bed at Executive Towers, Business Bay, AED 138,000, pets allowed.">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="sp-pf" viewBox="0 0 100 150"><circle cx="50" cy="50" r="50" fill="#EF5E4E"/><path d="M0 50 H50 V100 A50 50 0 0 1 0 50 Z" fill="#fff"/><path d="M0 100 H50 A50 50 0 0 1 0 150 Z" fill="#EF5E4E"/></symbol><symbol id="sp-paw" viewBox="0 0 24 24"><g fill="currentColor"><circle cx="6" cy="9" r="2"/><circle cx="10" cy="5" r="2"/><circle cx="14" cy="5" r="2"/><circle cx="18" cy="9" r="2"/><path d="M12 9c-3 0-6 3-6 6a3 3 0 0 0 3 3c1 0 2-.5 3-.5s2 .5 3 .5a3 3 0 0 0 3-3c0-3-3-6-6-6z"/></g></symbol></svg>
  <canvas class="sp-dots" aria-hidden="true"></canvas>

  <div class="sp-phone" aria-hidden="true"><div class="sp-lift"><div class="sp-skin"></div><div class="sp-glass"></div><div class="sp-scr">
    <div class="sp-top"><span class="br"><svg class="pf" viewBox="0 0 100 150"><use href="#sp-pf"/></svg>Scout</span><span class="mn"><i></i><i></i><i></i></span></div>
    <div class="sp-first"><div class="orb"><canvas width="330" height="330"></canvas></div><b>What are you looking for?</b><span>Tell me what you need. I'll do the searching.</span></div>
    <div class="sp-thread">
      <div class="m u">2-bed near my office in DIFC, around 130k a year. I have a dog</div>
      <div class="m s"><span class="av"><svg class="pf" viewBox="0 0 100 150"><use href="#sp-pf"/></svg></span><span class="b"><span class="dots"><i></i><i></i><i></i></span><span class="t">Closest is Business Bay, one minute's drive away: a pet-friendly 2-bed at Executive Towers, 138k, 640m from the metro.</span></span></div>
    </div>
  </div></div></div>

  <div class="sp-mem" aria-hidden="true">
    <span class="lab">What Scout understood</span>
    <span class="bar"><svg class="pf" viewBox="0 0 100 150"><use href="#sp-pf"/></svg><span>2-bed</span><i>·</i><span class="as">near DIFC</span><i>·</i><span>~130k/year</span><i>·</i><span>pet-friendly</span></span>
  </div>
  <div class="sp-res" aria-hidden="true"><span class="lab">What Scout found</span><div class="rc"><img src="/work/scout-home.jpg" alt="" width="480" height="320" loading="lazy" decoding="async" /><span class="bd"><b>AED 138,000<small> / year</small></b><span>2 bed · 3 bath · 1,420 sq ft</span><span class="w">Executive Towers, Business Bay</span><span class="tags"><em class="over">Over budget</em><em><svg viewBox="0 0 24 24"><use href="#sp-paw"/></svg>Pets allowed</em></span></span></div></div>
</div>

<style>
  /* the ground is the theme's own surface; the phone keeps Scout's light palette, as the product does */
  .sp{--bg:#F7F5F2;--ink:#1B1B1F;--ink2:#5B5B63;--ink3:#8E8E96;--coral:#EF5E4E;--soft:#FBE9E5;--scout:#F0EDE8;--pline:rgba(27,27,31,.08);
    --ease:cubic-bezier(.2,.7,.2,1);
    position:relative;display:block;width:100%;aspect-ratio:16/10;overflow:hidden;background:var(--color-surface);
    font-family:"Inter",-apple-system,BlinkMacSystemFont,system-ui,sans-serif;container-type:inline-size}
  .sp-dots{position:absolute;inset:0;width:100%;height:100%;display:block}

  /* the phone: a positioning wrapper that moves aside; the lift carries the intro (script) */
  .sp-phone{position:absolute;left:50%;top:6cqw;width:40cqw;aspect-ratio:330/680;transform:translateX(-50%);transition:transform .9s var(--ease);perspective:140cqw}
  .sp.wide .sp-phone{transform:translateX(7cqw)}
  .sp-lift{position:relative;height:100%;padding:1.25cqw;transform-origin:50% 24%;will-change:transform}
  .sp-skin{position:absolute;inset:0;border-radius:6.4cqw;background:#141416;box-shadow:0 0 0 1px rgba(255,255,255,.06),0 4cqw 8cqw -3cqw rgba(0,0,0,.55)}
  .sp-glass{position:absolute;inset:1.25cqw;border-radius:5.2cqw;background:var(--bg)}
  .sp-scr{position:relative;height:100%;border-radius:5.2cqw;color:var(--ink);overflow:hidden;container-type:inline-size}
  /* inside the screen, sizes follow the prototype at 312px wide: 1px there is .32cqw here */
  .sp-top{display:flex;align-items:center;justify-content:space-between;padding:5.8cqw 5cqw 2.6cqw 5.8cqw}
  .sp-top .br{display:flex;align-items:center;gap:2.2cqw;font-weight:600;font-size:5.4cqw;letter-spacing:-.01em}
  .pf{display:block}
  .sp-top .pf{width:5.1cqw;height:7.7cqw}
  .sp-top .mn{display:flex;gap:1.3cqw}.sp-top .mn i{width:1.6cqw;height:1.6cqw;border-radius:50%;background:var(--ink3)}
  .sp-first{position:absolute;left:0;right:0;top:20cqw;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 6cqw;transition:opacity .5s var(--ease),transform .5s var(--ease)}
  .sp-first .orb{width:61cqw;height:61cqw;margin-bottom:4.5cqw}
  .sp-first canvas{display:block;width:100%;height:100%}
  .sp-first b{font-size:6.2cqw;font-weight:600;letter-spacing:-.02em;margin-bottom:2.6cqw;white-space:nowrap}
  .sp-first span{font-size:4.3cqw;line-height:1.5;color:var(--ink2)}
  .sp-thread{position:absolute;left:4.5cqw;right:4.5cqw;top:20cqw;display:flex;flex-direction:column;gap:3.2cqw;font-size:4.3cqw;line-height:1.42}
  .sp-thread > *{transition:opacity .55s var(--ease),transform .55s var(--ease)}
  .m.u{align-self:flex-end;max-width:84%;background:var(--coral);color:#fff;padding:2.9cqw 3.8cqw;border-radius:5.4cqw 5.4cqw 1.6cqw 5.4cqw}
  .m.s{display:flex;align-items:flex-end;gap:2.2cqw;max-width:92%}
  .m .av{flex:none;width:7.7cqw;height:7.7cqw;border-radius:50%;background:#fff;display:grid;place-items:center;box-shadow:0 0 0 1px var(--pline)}
  .m .av .pf{width:3.2cqw;height:4.8cqw}
  .m .b{display:block;background:var(--scout);padding:2.9cqw 3.8cqw;border-radius:5.4cqw 5.4cqw 5.4cqw 1.6cqw}
  /* while Scout thinks the bubble is the size of its dots; the reply replaces them */
  .m .b .t{display:none}
  .sp:is(.s5,.s6) .m .b .t{display:block;animation:sp-in .45s var(--ease) both}
  .sp:is(.s5,.s6) .m .b .dots{display:none}
  @keyframes sp-in{from{opacity:0}}
  .dots{display:flex;gap:1.3cqw;align-items:center;height:1.42em}
  .dots i{width:1.9cqw;height:1.9cqw;border-radius:50%;background:var(--ink3);animation:sp-blink 1.2s infinite}
  .dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}

  /* what Scout understood, and the home it found: both rise out of the phone */
  .sp-mem{position:absolute;left:4cqw;top:22%;display:flex;flex-direction:column;gap:1.2cqw;transition:opacity .7s var(--ease),transform .7s var(--ease)}
  .sp-mem .lab{font:400 1.6cqw/1.2 var(--font-mono,ui-monospace,monospace);color:color-mix(in srgb,var(--color-primary) 70%,transparent)}
  .sp-mem .bar{display:flex;align-items:center;gap:1cqw;white-space:nowrap;background:#fff;color:var(--ink);border-radius:2cqw;padding:1.4cqw 1.8cqw;font-size:1.9cqw;box-shadow:0 2cqw 5cqw -2cqw rgba(0,0,0,.45)}
  .sp-mem .pf{flex:none;width:1.35cqw;height:2cqw}
  .sp-mem i{font-style:normal;color:#C4C4CA}
  .sp-mem .as{color:var(--ink2)}.sp-mem .as::after{content:"?";color:var(--coral);font-weight:600}
  .sp-mem .bar span{border-radius:.5cqw;transition:background 1.2s 1.4s,box-shadow 1.2s 1.4s}
  .sp.s4 .sp-mem .bar span{background:var(--soft);box-shadow:0 0 0 .4cqw var(--soft)}
  .sp-res{position:absolute;left:4cqw;top:47%;width:47cqw;display:flex;flex-direction:column;gap:1.2cqw;transform-origin:right center;transition:opacity .6s var(--ease),transform .9s var(--ease)}
  .sp-res .lab{font:400 1.6cqw/1.2 var(--font-mono,ui-monospace,monospace);color:color-mix(in srgb,var(--color-primary) 70%,transparent)}
  .sp-res .rc{display:flex;align-items:center;gap:1.6cqw;padding:1.1cqw 1.8cqw 1.1cqw 1.1cqw;background:#fff;color:var(--ink2);border-radius:2.2cqw;box-shadow:0 2.4cqw 5cqw -2cqw rgba(0,0,0,.5)}
  .sp-res img{flex:none;width:12cqw;height:9cqw;object-fit:cover;border-radius:1.4cqw}
  .sp-res .bd{display:flex;flex-direction:column;gap:.35cqw;min-width:0;font-size:1.75cqw}
  .sp-res b{color:var(--ink);font-size:2.3cqw;font-weight:700}.sp-res small{font-weight:400;color:var(--ink3);font-size:1.6cqw}
  .sp-res .w{color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tags{display:flex;gap:.6cqw;margin-top:.5cqw}
  .tags em{display:inline-flex;align-items:center;gap:.5cqw;white-space:nowrap;font-style:normal;font-size:1.5cqw;padding:.35cqw 1cqw;border-radius:5cqw;background:var(--bg);box-shadow:0 0 0 1px var(--pline)}
  .tags em.over{background:#FFF4E5;box-shadow:0 0 0 1px #F5C88A;color:#8A5A12}
  .tags svg{width:1.5cqw;height:1.5cqw}

  /* the loop: s1 the first screen, s2 the message, s3 Scout thinks, s4 the memory comes out, s5 the reply, s6 the home */
  :global(html.js) .sp .m{opacity:0;transform:translateY(3cqw)}
  :global(html.js) .sp .sp-mem{opacity:0;transform:translateX(-2cqw)}
  :global(html.js) .sp .sp-res{opacity:0;transform:translate(22cqw,3cqw) scale(.9)}
  :global(html.js) .sp:is(.s2,.s3,.s4,.s5,.s6) .sp-first{opacity:0;transform:translateY(-4cqw)}
  :global(html.js) .sp:is(.s2,.s3,.s4,.s5,.s6) .m.u,:global(html.js) .sp:is(.s3,.s4,.s5,.s6) .m.s{opacity:1;transform:none}
  :global(html.js) .sp:is(.s4,.s5,.s6) .sp-mem,:global(html.js) .sp.s6 .sp-res{opacity:1;transform:none}
  :global(html.js) .sp.out .sp-thread > *,:global(html.js) .sp.out .sp-mem,:global(html.js) .sp.out .sp-res{opacity:0!important}

  /* phones: square, the phone centred and cut off; the home and the memory float over its lower half, without labels */
  @media (max-width:599px){
    .sp{aspect-ratio:1/1}
    .sp-phone{top:7cqw;width:66cqw}
    .sp.wide .sp-phone{transform:translateX(-50%)}
    .sp-lift{padding:1.9cqw}
    .sp-skin{border-radius:9.6cqw}.sp-glass{inset:1.9cqw;border-radius:7.8cqw}.sp-scr{border-radius:7.8cqw}
    .sp-mem{left:4cqw;right:4cqw;top:auto;bottom:5cqw;align-items:center}
    .sp-mem .lab{display:none}
    .sp-mem .bar{font-size:3.4cqw;padding:2.4cqw 3.2cqw;border-radius:3.6cqw;gap:1.6cqw}
    .sp-mem .pf{width:2.4cqw;height:3.6cqw}
    .sp-res{left:6cqw;right:6cqw;width:auto;top:auto;bottom:21cqw;transform-origin:center bottom}
    .sp-res .lab{display:none}
    .sp-res .rc{gap:2.6cqw;padding:1.8cqw 3cqw 1.8cqw 1.8cqw;border-radius:3.6cqw}
    :global(html.js) .sp .sp-res{transform:translate(0,6cqw) scale(.94)}
    :global(html.js) .sp.s6 .sp-res{transform:none}
    .sp-res img{width:18cqw;height:13cqw;border-radius:2.2cqw}
    .sp-res .bd{font-size:2.9cqw}.sp-res b{font-size:3.7cqw}.sp-res small{font-size:2.6cqw}
    .tags em{font-size:2.5cqw;padding:.5cqw 1.5cqw}.tags svg{width:2.5cqw;height:2.5cqw}
  }
  @keyframes sp-blink{0%,100%{opacity:.25}50%{opacity:1}}
  @media (prefers-reduced-motion:reduce){
    .dots i{animation:none}
    .sp-phone,.sp-first,.sp-thread > *,.sp-mem,.sp-res{transition:none}
  }
</style>

<script>
  // The loop, at the chat's own pace: a message, a beat while Scout thinks, then the answer.
  function scoutPromo() {
    const sp = document.querySelector<HTMLElement>('[data-scout-promo]');
    if (!sp || (sp as any).__on) return;
    (sp as any).__on = true;
    const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = sp.querySelector<HTMLCanvasElement>('.sp-first canvas')!;
    const lift = sp.querySelector<HTMLElement>('.sp-lift')!, skin = sp.querySelector<HTMLElement>('.sp-skin')!, glass = sp.querySelector<HTMLElement>('.sp-glass')!;
    const late = [sp.querySelector<HTMLElement>('.sp-top')!, ...sp.querySelectorAll<HTMLElement>('.sp-first > :not(.orb)')];
    let orb: any = null, timers: number[] = [], state = 'idle', n = 1, vis = false;

    // ── the dots: a grid in the theme's ink; the ones behind the memory bar brighten softly when it comes out ──
    const cv = sp.querySelector<HTMLCanvasElement>('.sp-dots')!, ctx = cv.getContext('2d')!;
    let W = 0, H = 0, rgb = [237, 235, 228], raf = 0, glowAt: any = null;
    const ink = () => { const d = document.createElement('i'); d.style.color = 'var(--color-primary)'; sp.appendChild(d); const m = getComputedStyle(d).color.match(/[\d.]+/g) || []; d.remove(); return m.slice(0, 3).map(Number); };
    const size = () => { const r = sp.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1); W = r.width; H = r.height; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    const draw = (now: number) => {
      ctx.clearRect(0, 0, W, H);
      const step = Math.max(9, W / 64), r0 = Math.max(.7, W / 900);
      for (let y = step / 2; y < H; y += step) for (let x = step / 2; x < W; x += step) {
        let a = .14, s = 1;
        if (glowAt) { const t = (now - glowAt.t) / 1000, d = Math.hypot((x - glowAt.x) / glowAt.w, (y - glowAt.y) / glowAt.h), k = Math.max(0, 1 - d) * Math.min(1, t * 2) * Math.max(0, 1 - Math.max(0, t - 1.2) / 1.6); a += k * .35; s += k * .6; }
        ctx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${Math.min(.7, a)})`;
        ctx.beginPath(); ctx.arc(x, y, r0 * s, 0, 6.2832); ctx.fill();
      }
      if (glowAt && (now - glowAt.t) / 1000 > 2.8) glowAt = null;
      raf = glowAt ? requestAnimationFrame(draw) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(draw); };
    const repaint = () => { rgb = ink(); size(); draw(performance.now()); };
    new ResizeObserver(repaint).observe(sp);
    new MutationObserver(repaint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const glow = () => { const b = sp.querySelector('.sp-mem .bar')!.getBoundingClientRect(), r = sp.getBoundingClientRect(); glowAt = { x: b.left - r.left + b.width / 2, y: b.top - r.top + b.height / 2, w: b.width * .9, h: b.height * 2.4, t: performance.now() }; kick(); };

    // ── the orb runs while the first screen is showing and the card is on screen; it never sits there undrawn ──
    const syncOrb = () => { if (!orb) return; if (n <= 1 && vis && !document.hidden) orb.resume(); else orb.pause(); };
    const stage = (k: number) => {
      n = k;
      sp.classList.remove('s1', 's2', 's3', 's4', 's5', 's6', 'out', 'wide');
      if (k) sp.classList.add('s' + k);
      if (k >= 4) sp.classList.add('wide');
      syncOrb();
    };
    // three.js and the shader load only when the card is near; rendered at the prototype's own size (220)
    const startOrb = async () => {
      if (orb) return;
      const [THREE, { createOrb }] = await Promise.all([import('three'), import('../scripts/scout-orb')]);
      orb = createOrb(THREE, canvas, { size: 220 });
      syncOrb();
    };
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { o.disconnect(); startOrb().catch(() => {}); } }, { rootMargin: '400px 0px' }).observe(sp);

    // ── the intro: the orb alone on the dots, then the camera pulls back. It zooms out flat, tilts back as the
    // phone lands, then straightens, the phone fading in around the orb. The move is sampled from smooth curves
    // into one animation, so it never stops halfway, and it ends at rest, so nothing jumps when it's done. ──
    const ease = (x: number) => 1 - Math.pow(1 - x, 3), clamp = (x: number) => Math.min(1, Math.max(0, x));
    const PULL: Keyframe[] = [];
    for (let i = 0; i <= 48; i++) {
      const t = i / 48;
      const z = ease(clamp((t - .05) / .7));                                // zoom: 1.6 to 1, easing out
      const tilt = Math.sin(Math.PI * clamp((t - .3) / .7)) ** 2;           // tilt: rises and settles back, smooth at both ends
      PULL.push({ offset: t, transform: `translateY(${(5 * (1 - z)).toFixed(2)}%) scale(${(1.6 - .6 * z).toFixed(4)}) rotateX(${(16 * tilt).toFixed(2)}deg) rotateZ(${(-3 * tilt).toFixed(2)}deg)` });
    }
    PULL[48].transform = 'none';
    let introAnims: Animation[] = [];
    const clear = () => [lift, skin, glass, ...late].forEach((e) => e.getAnimations().forEach((a) => a.cancel()));
    // the intro is built paused, so the card can rest on its first frame (the orb alone) until it plays
    const intro = (paused = false) => {
      clear();
      introAnims = [
        lift.animate(PULL, { duration: 2600, delay: 200, easing: 'linear', fill: 'backwards' }),
        ...[skin, glass].map((e) => e.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1000, delay: 400, easing: 'ease-out', fill: 'backwards' })),
        ...late.map((e) => e.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 600, delay: 2000, fill: 'backwards' })),
      ];
      if (paused) introAnims.forEach((a) => a.pause());
    };
    // the way back, so the loop has no cut: once the chat has cleared and the phone is back in the middle,
    // the words fade, the phone fades and the camera moves back in to the orb, landing exactly on the intro's
    // first frame
    const outro = () => {
      clear();
      late.forEach((e) => e.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, fill: 'forwards' }));
      [skin, glass].forEach((e) => e.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 900, delay: 300, easing: 'ease-in', fill: 'forwards' }));
      lift.animate([{ transform: 'none' }, { transform: PULL[0].transform as string }], { duration: 1300, easing: 'cubic-bezier(.6,0,.4,1)', fill: 'forwards' });
    };

    if (RM) { stage(6); return; }
    intro(true);   // at rest: the orb alone, ready to pull back
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const play = () => {
      state = 'playing';
      const loop = (first: boolean) => {
        stage(1);
        if (first) introAnims.forEach((a) => a.play()); else intro();
        at(3900, () => stage(2));
        at(5000, () => stage(3));
        at(6200, () => { stage(4); glow(); });
        at(7800, () => stage(5));
        at(9200, () => stage(6));
        at(13100, () => sp.classList.add('out'));      // the chat, the memory and the home fade
        at(13800, () => stage(1));                     // the first screen returns; the phone slides back to the middle
        at(14900, outro);                              // and the camera moves back in to the orb
        at(16400, () => loop(false));
      };
      loop(true);
    };
    const reset = () => { timers.forEach(clearTimeout); timers = []; state = 'idle'; stage(1); intro(true); };
    const seen = () => { const r = sp.getBoundingClientRect(); const h = Math.min(r.height, innerHeight); return h ? Math.max(0, Math.min(r.bottom, innerHeight) - Math.max(r.top, 0)) / h : 0; };
    const check = () => { const v = seen(); vis = v > 0; if (state === 'idle' && v >= 0.4) play(); else if (state !== 'idle' && v === 0) reset(); syncOrb(); };
    let tk = false;
    addEventListener('scroll', () => { if (!tk) { tk = true; requestAnimationFrame(() => { tk = false; check(); }); } }, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) reset(); else check(); });
    stage(1); check();
  }
  document.addEventListener('astro:page-load', scoutPromo);
</script>
