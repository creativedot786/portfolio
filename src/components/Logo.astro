---
import { LOGO_FACE, LOGO_GLASSES } from '../data/logo';
interface Props { size?: number }
const { size = 56 } = Astro.props;
const id = `lens-${size}`;
---
<span class="logo relative grid place-items-center shrink-0" style={`--s:${size}px;width:var(--s);height:var(--s)`} aria-hidden="true">
  <svg viewBox="0 0 44 44" width={size} height={size} focusable="false" class="block w-full h-full overflow-visible">
    <defs>
      <clipPath id={id}><path d={LOGO_GLASSES} /></clipPath>
      <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"   style="stop-color:var(--color-primary);stop-opacity:0" />
        <stop offset=".5"  style="stop-color:var(--color-primary);stop-opacity:.8" />
        <stop offset="1"   style="stop-color:var(--color-primary);stop-opacity:0" />
      </linearGradient>
    </defs>
    <path d={LOGO_FACE} fill="var(--color-primary)" />
    <path class="glasses" d={LOGO_GLASSES} fill="var(--color-accent)" />
    <g clip-path={`url(#${id})`}>
      <rect class="glint" x="0" y="20" width="18" height="16" fill={`url(#${id}-g)`} />
    </g>
  </svg>
</span>
<style>
  /* The face is the theme's ink and the glasses its accent. The glint is a soft band of ink
     clipped to the lens shapes, sweeping left to right — glasses catching the light. It runs
     once on load, again on hover, and again when the theme changes; never on a loop. */
  .glasses{transition:fill .45s var(--ease-out-soft)}
  .glint{
    opacity:0;
    transform:translateX(-12px) skewX(-22deg);
    transform-box:fill-box;transform-origin:center;
    animation:glint 2s cubic-bezier(.4,0,.2,1) .8s both;
  }
  .logo.shine .glint,
  .logo:hover .glint,
  :global(.logo-link:hover) .glint{animation:glint-again 1.8s cubic-bezier(.4,0,.2,1) both}
  @keyframes glint{
    0%{transform:translateX(-20px) skewX(-22deg);opacity:0}
    12%{opacity:1} 88%{opacity:1}
    100%{transform:translateX(38px) skewX(-22deg);opacity:0}
  }
  @keyframes glint-again{
    0%{transform:translateX(-20px) skewX(-22deg);opacity:0}
    12%{opacity:1} 88%{opacity:1}
    100%{transform:translateX(38px) skewX(-22deg);opacity:0}
  }
  @media (prefers-reduced-motion:reduce){.glint{animation:none!important;opacity:0}}
</style>
