---
import type { Work } from '../data/work';
import ScoutPromo from './ScoutPromo.astro';
import TradelingPromo from './TradelingPromo.astro';
interface Props { item: Work; index: number; total: number }
const { item } = Astro.props;

---
<section class="promo section" id={`work-${item.slug}`} data-promo aria-labelledby={`promo-${item.slug}`}>
  <div class="shell gap-y-5 lg:items-center">
    <div class="promo-text col-text">
      <p class="text-meta font-bold mb-3 text-accent">{item.industryLabel} · {item.platform}</p>
      <h3 id={`promo-${item.slug}`} class="text-h2 mb-3 max-w-[20ch]"><a class="promo-link" href={item.href} data-astro-reload>{item.title}</a></h3>
      <p class="text-body text-secondary">{item.line}</p>
      <p class="mt-3"><a class="promo-cta" href={item.href} data-astro-reload tabindex="-1" aria-hidden="true" data-roll>Read the case study<svg class="arr" viewBox="0 0 14.4 14.4" aria-hidden="true"><path d="M1.2 13.2L13.2 1.2M13.2 1.2H1.2M13.2 1.2V13.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" fill="none"/></svg></a></p>
    </div>
    <a class="col-media block max-lg:order-first" href={item.href} data-astro-reload tabindex="-1" aria-hidden="true">
      {item.slug === 'scout' ? <ScoutPromo /> : item.slug === 'tradeling-b2b' ? <TradelingPromo /> : item.image ? (
        <img
          class="promo-img block w-full aspect-[16/10] object-cover bg-surface"
          src={item.image}
          alt={item.alt}
          width="2200"
          height="1375"
          loading="lazy"
          decoding="async"
          data-cursor-expand
        />
      ) : (
        <div class="ph promo-img w-full aspect-[16/10]" data-cursor-expand><span>Case study image</span></div>
      )}
    </a>
  </div>
</section>
<style>
  /* the title is the link; the image and the call to action point to the same page for mouse and touch.
     data-astro-reload: case studies are standalone pages, so they load in full rather than through the view-transition router */
  .promo-link{color:inherit;text-decoration:none}
  .promo-cta{display:inline-flex;align-items:center;gap:7px;font-weight:600;font-size:var(--text-meta);color:var(--color-secondary);text-decoration:none;transition:color .2s var(--ease-out-soft)}
  .promo-cta svg{width:.72em;height:.72em}
  .promo-cta:hover,.promo:has(.promo-link:hover) .promo-cta{color:var(--color-primary)}
  /* the shared arrow nudge (global.css) also runs when the title or the image is hovered */
  .promo:has(.promo-link:hover,.col-media:hover) .promo-cta :global(.arr){transform:translate(2px,-2px);opacity:1}
  /* and its letters roll, as if the call to action itself were hovered */
  .promo:has(.promo-link:hover,.col-media:hover) .promo-cta :global(.hc-c > span){transform:translateY(-1.3em)}
  :global(html.js) .promo-text > *{opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease-out-soft),transform .6s var(--ease-out-soft)}
  :global(html.js) .promo-text > *:nth-child(2){transition-delay:70ms}
  :global(html.js) .promo-text > *:nth-child(3){transition-delay:140ms}
  :global(html.js) .promo-text > *:nth-child(4){transition-delay:210ms}
  :global(html.js) .promo-img{opacity:0;transform:scale(1.035);transition:opacity .8s var(--ease-out-soft),transform 1.2s var(--ease-out-soft)}
  :global(html.js) .promo.in .promo-text > *{opacity:1;transform:none}
  :global(html.js) .promo.in .promo-img{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){
    :global(html.js) .promo-text > *,:global(html.js) .promo-img{opacity:1;transform:none;transition:none}
  }
</style>
<script>
  function promos() {
    const secs = [...document.querySelectorAll<HTMLElement>('[data-promo]')];
    if (!secs.length) return;
    const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.4 });
    secs.forEach((s) => { if (!(s as any).__io) { (s as any).__io = true; io.observe(s); } });

    const dots = document.querySelector<HTMLElement>('[data-dots]');
    const work = document.getElementById('work');
    if (!dots || !work || (dots as any).__init) return;
    (dots as any).__init = true;
    const links = [...dots.querySelectorAll<HTMLAnchorElement>('a')];
    new IntersectionObserver((es) => { dots.classList.toggle('show', es[0].isIntersecting); }, { rootMargin: '-35% 0px -35% 0px' }).observe(work);
    const active = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { const i = secs.indexOf(e.target as HTMLElement); links.forEach((l, k) => l.classList.toggle('on', k === i)); } });
    }, { threshold: 0.55 });
    secs.forEach((s) => active.observe(s));
    links.forEach((l, i) => l.addEventListener('click', (e) => {
      e.preventDefault();
      secs[i].scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }));
  }
  document.addEventListener('astro:page-load', promos);
</script>
