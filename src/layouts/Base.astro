---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Rail from '../components/Rail.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { CursorMultifollow } from '../components/ui/motion-cursor-multifollow';
import { site } from '../data/site';
import { themes, defaultTheme } from '../data/themes';

// nav: the page's sections for the rail and the phone menu (the home page's by default).
// caseStudy: the logo goes home and "All work" sits under it, instead of the home page's Resume link.
// image: the picture a shared link shows (2400 × 1260, drawn by `npm run og`); imageAlt describes it.
interface Props { title: string; description: string; nav?: [string, string][]; caseStudy?: boolean; image?: string; imageAlt?: string }
const { title, description, nav, caseStudy = false, image = '/og/home.png',
  imageAlt = `${site.name}, ${site.title}. Designing at scale. Building with AI.` } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
// each theme's page colour, for the head script below; the default theme sets no attribute
const grounds: Record<string, string> = Object.fromEntries(themes.filter((t) => t.id !== defaultTheme).map((t) => [t.id, t.ground]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- search results and Google Discover may show the sharing image large -->
    <meta name="robots" content="max-image-preview:large" />
    <meta name="theme-color" content={themes[0].ground} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline data-astro-rerun define:vars={{ grounds }}>
      document.documentElement.classList.add('js');
      // Hide the system cursor only where the custom one will actually render.
      try {
        if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('has-cursor');
        }
      } catch (e) {}
      try {
        if (sessionStorage.getItem('hr-loader') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('no-loader');
          // Any later visit: the loader shows only if the page is still loading after a moment.
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('ld-wait');
        } else {
          // First visit: hold the page until the logo has drawn, then let the content in.
          // Set before first paint so nothing flashes.
          document.documentElement.classList.add('intro');
        }
      } catch (e) {}
      // Theme and grid are restored before first paint, so a Cream visitor never sees a dark flash.
      try {
        var t = localStorage.getItem('hr-theme');
        // only the current themes (grounds, from src/data/themes.ts); a theme saved from an older set falls back to the default
        if (t && grounds[t]) {
          document.documentElement.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.content = grounds[t];
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <Loader />
    <Rail nav={nav} caseStudy={caseStudy} />
    <MobileNav nav={nav} caseStudy={caseStudy} />
    <main id="main"><slot /></main>
    <Footer />
    <CursorMultifollow client:idle />
    <script>
      import { rolls, grid } from '../scripts/site';
      // ── the intro ──────────────────────────────────────────────
      // 0        the logo draws and fills (Loader.astro)
      // 1100ms   the loader dissolves
      // 2000ms   the page and the rail fade in and the hero rises
      // Any later visit in the session skips it; the loader then shows only while the page is still loading
      // (it fades in after a moment, in CSS) and fades away once everything has loaded, or after 4s at most.
      // Reduced motion skips it all.
      function loader() {
        const l = document.getElementById('loader');
        const root = document.documentElement;
        if (!l) return;
        let seen = false;
        try { seen = !!sessionStorage.getItem('hr-loader'); } catch (e) {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.remove('intro');
          if (!root.classList.contains('ld-wait')) { l.remove(); return; }
          let gone = false;
          const done = () => {
            if (gone) return; gone = true;
            const o = getComputedStyle(l).opacity;
            const fin = () => { l.remove(); root.classList.remove('ld-wait'); };
            if (+o < .05) fin(); else l.animate([{ opacity: o }, { opacity: 0 }], { duration: 400, easing: 'ease-out' }).onfinish = fin;
          };
          if (document.readyState === 'complete') done(); else { addEventListener('load', done); setTimeout(done, 4000); }
          return;
        }
        setTimeout(() => {
          l.classList.add('out');
          try { sessionStorage.setItem('hr-loader', '1'); } catch (e) {}
          setTimeout(() => l.remove(), 500);
        }, 1100);
        setTimeout(() => {
          root.classList.remove('intro');
          revealCheck();
        }, 2000);
      }
      // Reveals are checked inside the scroll loop below rather than by IntersectionObserver.
      // IO is suspended whenever the document is not rendering, and one loop driving reveal,
      // drift and the scrolling flag is simpler than three mechanisms doing similar work.
      function revealCheck() {
        if (document.documentElement.classList.contains('intro')) return;   // not until the intro is done
        const vh = innerHeight;
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.92 && r.bottom > 0) el.classList.add('in');
        });
      }
      // ── shared scroll loop: drift planes + the scrolling flag ──
      // One rAF per scroll for everything that rides the scroll position. Drift is measured
      // from each element's distance to the viewport centre, so an element sits exactly at its
      // authored position when centred and moves only as it enters and leaves.
      function scrollLoop() {
        if (window.__scrollLoop) return;
        window.__scrollLoop = true;
        const root = document.documentElement;
        const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let ticking = false, idle = 0;
        const drift = () => {
          if (rm || !matchMedia('(min-width: 1024px)').matches) return;
          const mid = innerHeight / 2;
          document.querySelectorAll('[data-drift]').forEach((el) => {
            const r = el.getBoundingClientRect();
            const rate = parseFloat(el.getAttribute('data-rate') || '0');
            const y = (r.top + r.height / 2 - mid) * rate;
            el.style.setProperty('--y', y.toFixed(1) + 'px');
          });
        };
        const frame = () => { ticking = false; drift(); revealCheck(); };
        addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(frame); }
          // The grid flare pauses while the page moves, and resumes once it has been still.
          root.classList.add('scrolling');
          clearTimeout(idle);
          idle = setTimeout(() => root.classList.remove('scrolling'), 180);
        }, { passive: true });
        addEventListener('resize', frame, { passive: true });
        drift();
        revealCheck();
      }
      // Case studies reveal as the home page does: blocks fade up as they come into view, once each. The units
      // are the direct children of each section's grid; one taller than the screen is split into its children,
      // so a long section reveals row by row instead of all at once. Reduced motion shows everything (global.css).
      function caseReveals() {
        if (!document.querySelector('.cs-head')) return;
        const collect = (el: Element, depth: number) => {
          if (depth < 3 && el.children.length && el.getBoundingClientRect().height > innerHeight * 1.1) {
            [...el.children].forEach((c) => collect(c, depth + 1));
          } else el.classList.add('reveal');
        };
        document.querySelectorAll('header.cs-head > .shell > *, section.ch > .shell > *, .cs section > .shell > *').forEach((el) => collect(el, 0));
      }
      document.addEventListener('astro:page-load', () => { rolls(); grid(); caseReveals(); loader(); scrollLoop(); revealCheck(); });
    </script>
  </body>
</html>
