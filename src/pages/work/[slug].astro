---
// Case studies are standalone pages, built from the case study drafts and written to src/case-studies
// by the export script; their images live in public/work/<slug>/i/. Astro only serves them, at /work/<slug>/.
export function getStaticPaths() {
  const pages = import.meta.glob('../../case-studies/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
  return Object.entries(pages).map(([path, html]) => ({ params: { slug: path.split('/').pop()!.replace('.html', '') }, props: { html } }));
}
const { html } = Astro.props;
---
<Fragment set:html={html} />
